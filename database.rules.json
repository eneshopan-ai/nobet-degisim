{
  "rules": {
    ".read": false,
    ".write": false,
    "nobetler": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() || !newData.exists()",
        ".validate": "newData.hasChildren(['olusturan', 'karsi', 'tarih', 'ts'])",
        "olusturan": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40" },
        "karsi": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40" },
        "tarih": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
        "karsiTarih": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
        "ts": { ".validate": "newData.isNumber() && newData.val() == now" },
        "$other": { ".validate": false }
      }
    },
    "abonelikler": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['endpoint', 'keys', 'ts'])",
        "endpoint": { ".validate": "newData.isString() && newData.val().length <= 600 && newData.val().beginsWith('https://')" },
        "keys": {
          "p256dh": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "auth": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "$other": { ".validate": false }
        },
        "ts": { ".validate": "newData.isNumber() && newData.val() == now" },
        "$other": { ".validate": false }
      }
    }
  }
}
